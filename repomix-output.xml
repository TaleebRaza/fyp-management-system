assert.ok(loopback.has(appUrl.hostname) && loopback.has(dbUrl.hostname), 'Portal stress accepts loopback targets only.');
assert.equal(dbUrl.pathname, '/fyp_portal_stress_test', 'Use the dedicated test database.');
