      name: `Performance Student ${String(index + 1).padStart(5, '0')}`,
      email: `student${index + 1}@student.uoh.edu.pk`,
      rollNo: `F26-${String(index + 1).padStart(4, '0')}`,
      role: 'student',
      password,
