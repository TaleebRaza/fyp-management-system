  assert.ok(Number.isInteger(sessionCount) && sessionCount > 0 && sessionCount <= SESSION_CEILING);
  assert.ok(Number.isInteger(otherStudentCount) && otherStudentCount > 0 && otherStudentCount <= 5000);
