    name: `Performance Supervisor ${String(index + 1).padStart(4, '0')}`,
    email: `supervisor${index + 1}@performance.example.test`,
    rollNo: `E26-${String(index + 1).padStart(4, '0')}`,
    role: 'supervisor',
    password,
  }));
