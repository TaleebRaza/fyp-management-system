  },
  { timestamps: true }
);

VivaAuditEventSchema.index({ roundId: 1, occurredAt: -1 });
VivaAuditEventSchema.index({ sessionId: 1, occurredAt: -1 });

const VivaAuditEvent = mongoose.models.VivaAuditEvent
