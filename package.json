{
  "name": "fyp-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node tests/run-unit-tests.mjs",
    "test:viva:persistence": "node --test tests/viva-persistence.integration.test.mjs",
    "test:viva:admin": "node --test tests/viva-round-admin.integration.test.mjs",
    "test:viva:panels": "node --test tests/viva-panel-admin.integration.test.mjs",
    "test:viva:scheduling": "node --test tests/viva-scheduling.integration.test.mjs",
    "test:viva:session": "node --test tests/viva-session-dashboard.integration.test.mjs",
    "test:viva:access": "node --test tests/viva-access-restriction.integration.test.mjs",
    "test:viva:grading": "node --test tests/viva-grade-completion.integration.test.mjs",
    "test:viva:cancellation": "node --test tests/viva-cancellation.integration.test.mjs",
    "test:viva:workflow": "node --test tests/viva-workflow.integration.test.mjs",
    "test:viva:auto-scheduling": "node --test tests/viva-automatic-scheduling.integration.test.mjs",
    "test:viva:performance": "node --test tests/viva-performance.integration.test.mjs",
    "test:portal-pause:cache": "node --test tests/portal-pause-cache.integration.test.mjs",
    "capacity:reconcile": "node --env-file-if-exists=.env.local scripts/reconcile-supervisor-capacity.mjs",
    "capacity:repair": "node --env-file-if-exists=.env.local scripts/reconcile-supervisor-capacity.mjs --repair",
    "project:drift-audit": "node --env-file-if-exists=.env.local scripts/audit-project-drift.mjs",
    "storage:keys:audit": "node --env-file-if-exists=.env.local scripts/audit-storage-keys.mjs",
    "storage:integrity:audit": "node --env-file-if-exists=.env.local scripts/audit-storage-integrity.mjs",
    "storage:ledger:repair": "node --env-file-if-exists=.env.local scripts/audit-storage-integrity.mjs --repair",
    "indexes:refactor:audit": "node --env-file-if-exists=.env.local scripts/audit-refactor-indexes.mjs",
    "indexes:refactor:apply": "node --env-file-if-exists=.env.local scripts/apply-refactor-indexes.mjs --apply",
    "rate-limit:ttl:audit": "node --env-file-if-exists=.env.local scripts/update-rate-limit-ttl.mjs",
    "rate-limit:ttl:apply": "node --env-file-if-exists=.env.local scripts/update-rate-limit-ttl.mjs --apply",
    "passwords:audit": "node --env-file-if-exists=.env.local scripts/migrate-password-hashes.mjs",
    "passwords:migrate": "node --env-file-if-exists=.env.local scripts/migrate-password-hashes.mjs --apply",
    "deploy:preflight": "npm run indexes:refactor:audit && npm run rate-limit:ttl:audit && npm run passwords:audit",
    "verify:refactor": "npm run lint && npm run test:unit && npm run build",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@sentry/nextjs": "^10.50.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "mongoose": "^9.2.4",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "repomix": "^1.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
