# Database and authentication
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/fyp-portal
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fyp-portal

# Email notifications (Gmail SMTP)
EMAIL_USER=portal@example.com
EMAIL_APP_PASSWORD=replace-with-an-email-app-password
EMAIL_FROM_NAME=FYP Portal
EMAIL_REPLY_TO=portal@example.com

# Scheduled voice-cleanup endpoint
CRON_SECRET=replace-with-a-long-random-secret
