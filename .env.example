# Required application runtime settings
MONGODB_URI=mongodb://username:password@database-host:27017/fyp-portal?authSource=admin
NEXTAUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# Local MongoDB Compose overlay. Keep these only in /etc/fyp-portal/portal.env,
# never in a release. The MONGODB_URI uses percent-encoded application credentials.
# MONGODB_ROOT_USERNAME=fyp-root
# MONGODB_ROOT_PASSWORD=replace-with-a-long-random-secret
# MONGODB_APP_USERNAME=fyp-portal
# MONGODB_APP_PASSWORD=replace-with-a-long-random-secret
# MONGODB_REPLICA_SET_KEY=replace-with-a-shared-base64-secret-at-least-6-characters-long
# MONGODB_DATABASE=fyp-portal
# MONGODB_URI=mongodb://fyp-portal:encoded-password@mongo:27017/fyp-portal?authSource=fyp-portal&replicaSet=rs0
# FYP_MONGODB_DATA_DIR=/var/lib/fyp-portal/mongodb

# Public Caddy gateway. In public mode FYP_CADDY_SITE is the domain itself,
# which enables automatic HTTPS. For an institutional TLS proxy, set it to
# http://portal.example.edu and bind both ports to loopback.
# PORTAL_PUBLIC_URL=https://portal.example.edu
# FYP_CADDY_SITE=portal.example.edu
# FYP_CADDY_HTTP_BIND=80
# FYP_CADDY_HTTPS_BIND=443
# FYP_CADDY_DATA_DIR=/var/lib/fyp-portal/caddy
# FYP_STATE_DIR=/var/lib/fyp-portal/state

# Encrypted backups are written only by root. The recovery key must be a
# base64-encoded 32-byte value retained separately for clean-environment recovery.
# FYP_BACKUP_DIR=/var/lib/fyp-portal/backups
# FYP_BACKUP_STAGING_DIR=/var/lib/fyp-portal/backups/.staging
# FYP_BACKUP_RECOVERY_KEY=replace-with-a-random-base64-encoded-32-byte-recovery-key

# Generic SMTP. Configure every SMTP_* setting, or use the legacy Gmail settings below, never both.
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_TLS_MODE=starttls
# SMTP_USER=optional-username
# SMTP_PASSWORD=optional-password
SMTP_FROM_ADDRESS=fyp-portal@example.edu
SMTP_FROM_NAME=FYP Portal
# SMTP_REPLY_TO=fyp-office@example.edu

# Legacy Gmail fallback
# EMAIL_USER=portal@example.edu
# EMAIL_APP_PASSWORD=replace-with-a-gmail-app-password
# EMAIL_FROM_NAME=FYP Portal
# EMAIL_REPLY_TO=fyp-office@example.edu

# Generic S3-compatible storage. The browser endpoint is used only in signed URLs.
# For a direct public S3 endpoint, S3_ENDPOINT and S3_BROWSER_ENDPOINT may be the same.
S3_ENDPOINT=https://s3-internal.example.edu
S3_BROWSER_ENDPOINT=https://uploads.example.edu
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
S3_BUCKET_NAME=fyp-portal
S3_FORCE_PATH_STYLE=true
# Defaults to 9.5 GiB when omitted.
# STORAGE_QUOTA_BYTES=10200547328

# Local SeaweedFS storage mode. It is private to Compose and Caddy proxies the
# fyp-uploads bucket without rewriting signed requests.
# S3_ENDPOINT=http://seaweedfs:8333
# S3_BROWSER_ENDPOINT=https://portal.example.edu
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=replace-with-a-local-access-key
# S3_SECRET_ACCESS_KEY=replace-with-a-local-secret-key
# S3_BUCKET_NAME=fyp-uploads
# S3_FORCE_PATH_STYLE=true
# FYP_SEAWEEDFS_DATA_DIR=/var/lib/fyp-portal/seaweedfs

# Legacy Cloudflare R2 fallback. Configure this complete group only when S3_* is absent.
# R2_ACCOUNT_ID=replace-with-r2-account-id
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_BUCKET_NAME=fyp-portal

# Optional error monitoring. The public DSN is embedded in the browser bundle at build time.
# SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
# SENTRY_ORG=your-sentry-organization
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=replace-with-a-sentry-upload-token
